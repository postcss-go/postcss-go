{
  "schemaVersion": 1,
  "corpusVersion": "1.0.0",
  "owner": "postcss-go maintainers",
  "denominator": "Every case has equal weight, including unsupported and map cases; no exclusions. Require ceil(0.95 * cases.length). Forced success is not proof of auto selection or no hydration.",
  "plugins": {
    "postcss-import": "16.1.1",
    "postcss-nested": "8.0.1",
    "postcss": "8.5.15",
    "qualification-scalar": "1"
  },
  "cases": [
    {
      "id": "nested-default",
      "plugin": "postcss-nested",
      "options": {},
      "css": ".card { color: red; &:hover { color: blue } }",
      "map": false,
      "expectedHandle": "unsupported"
    },
    {
      "id": "nested-preserve",
      "plugin": "postcss-nested",
      "options": {
        "preserveEmpty": true
      },
      "css": ".card { .title { color: red } }",
      "map": false,
      "expectedHandle": "unsupported"
    },
    {
      "id": "nested-bubble",
      "plugin": "postcss-nested",
      "options": {
        "bubble": ["phone"]
      },
      "css": ".card { @phone { color: red } }",
      "map": false,
      "expectedHandle": "unsupported"
    },
    {
      "id": "import-default",
      "plugin": "postcss-import",
      "options": {},
      "css": "@import \"data:text/css,.base%7Bcolor%3Ared%7D\"; .end { color: blue }",
      "map": false,
      "expectedHandle": "unsupported"
    },
    {
      "id": "import-duplicates",
      "plugin": "postcss-import",
      "options": {
        "skipDuplicates": false
      },
      "css": "@import \"data:text/css,.base%7Bcolor%3Ared%7D\"; @import \"data:text/css,.base%7Bcolor%3Ared%7D\";",
      "map": false,
      "expectedHandle": "unsupported"
    },
    {
      "id": "nested-map",
      "plugin": "postcss-nested",
      "options": {},
      "css": ".card { &:hover { color: blue } }",
      "map": {
        "inline": false,
        "annotation": false
      },
      "expectedHandle": "unsupported"
    },
    {
      "id": "scalar",
      "plugin": "qualification-scalar",
      "options": {},
      "css": "a { color: red; margin: 0 }",
      "map": false,
      "expectedHandle": "supported"
    }
  ],
  "compatibilityDifferences": [
    {
      "case": "nested-map",
      "field": "map.mappings",
      "upstream": "AAAQ,cAAU,YAAY",
      "binary": "AAAQ,cAAU,OAAO,GAAG,EAAE",
      "owner": "postcss-go maintainers",
      "reason": "Existing bulk stringifier emits additional segments for nested declarations; exact source-map equivalence remains a Phase 4 blocker. This is a baseline observation, not rollout approval."
    }
  ]
}
