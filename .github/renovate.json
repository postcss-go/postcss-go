{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "ignorePaths": ["vendor/**"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "groupName": "go modules"
    },
    {
      "description": "Skip vendored upstream PostCSS snapshot (synced via upstream-postcss-sync workflow)",
      "matchFileNames": ["vendor/**"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
