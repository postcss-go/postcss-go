{
  "name": "@postcss-go/core",
  "version": "0.0.1",
  "description": "Node.js API and CLI for the postcss-go engine.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postcss-go": "./bin/postcss-go.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./bin": "./bin/postcss-go.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm --filter @postcss-go/shared build && tsc -p tsconfig.json && node ./native/build.mjs",
    "build:native": "node ./native/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json",
    "test": "pnpm run build && vitest run",
    "test:coverage": "pnpm run build && vitest run --coverage"
  },
  "dependencies": {
    "@postcss-go/shared": "workspace:*",
    "chokidar": "^3.6.0",
    "dependency-graph": "^1.0.0",
    "picocolors": "^1.1.1",
    "pretty-hrtime": "^1.0.3",
    "read-cache": "^1.0.0",
    "slash": "^5.1.0",
    "source-map-js": "^1.2.1",
    "tinyglobby": "^0.2.15"
  },
  "optionalDependencies": {
    "@postcss-go/native-darwin-arm64": "workspace:*",
    "@postcss-go/native-darwin-x64": "workspace:*",
    "@postcss-go/native-linux-arm64-gnu": "workspace:*",
    "@postcss-go/native-linux-arm64-musl": "workspace:*",
    "@postcss-go/native-linux-x64-gnu": "workspace:*",
    "@postcss-go/native-linux-x64-musl": "workspace:*",
    "@postcss-go/native-win32-arm64-msvc": "workspace:*",
    "@postcss-go/native-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "node-gyp": "11.4.2",
    "node-api-headers": "^1.9.0",
    "postcss": "^8.5.15",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "cli",
    "postcss",
    "postcss-go",
    "postcss-runner"
  ],
  "license": "MIT"
}
