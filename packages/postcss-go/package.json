{
  "name": "postcss-go",
  "version": "0.0.0",
  "description": "Node.js API and CLI for the postcss-go engine.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postcss-go": "./bin/postcss-go.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./wasm/worker": {
      "default": "./dist/wasm/worker.js"
    },
    "./wasm/postcss-go.wasm": {
      "default": "./dist/wasm/postcss-go.wasm"
    },
    "./wasm/wasm_exec.js": {
      "default": "./dist/wasm/wasm_exec.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./bin": "./bin/postcss-go.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:native && pnpm run build:wasm",
    "build:js": "pnpm --filter postcss-go-shared build && vite build",
    "build:native": "node ./native/build.mjs",
    "build:wasm": "node ../../scripts/build-wasm.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json",
    "test": "pnpm run build && vitest run",
    "test:core-css-contract": "pnpm run build && vitest run test/core-css-contract.test.ts test/wasm-backend-contract.test.ts test/plugin-contract.test.ts test/cli.test.ts",
    "test:browser-wasm": "pnpm run build:js && pnpm run build:wasm && node ../../scripts/browser-wasm-smoke.mjs",
    "test:coverage": "pnpm run build && vitest run --coverage"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dependency-graph": "^1.0.0",
    "picocolors": "^1.1.1",
    "pretty-hrtime": "^1.0.3",
    "read-cache": "^1.0.0",
    "slash": "^5.1.0",
    "source-map-js": "^1.2.1",
    "tinyglobby": "^0.2.15"
  },
  "optionalDependencies": {
    "postcss-go-native-darwin-arm64": "workspace:*",
    "postcss-go-native-darwin-x64": "workspace:*",
    "postcss-go-native-linux-arm64-gnu": "workspace:*",
    "postcss-go-native-linux-x64-gnu": "workspace:*",
    "postcss-go-native-win32-arm64-msvc": "workspace:*",
    "postcss-go-native-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "postcss-go-shared": "workspace:*",
    "node-api-headers": "^1.9.0",
    "node-gyp": "13.0.1",
    "postcss": "^8.5.15",
    "postcss-import": "16.1.1",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "cli",
    "postcss",
    "postcss-go",
    "postcss-runner"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eryue0220/postcss-go.git"
  },
  "bugs": {
    "url": "https://github.com/eryue0220/postcss-go/issues"
  },
  "homepage": "https://eryue0220.github.io/postcss-go/",
  "license": "MIT"
}
