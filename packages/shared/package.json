{
  "name": "@postcss-go/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared helpers for postcss-go packages and CJS compat overrides.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./map-options": {
      "types": "./dist/map-options.d.ts",
      "import": "./dist/map-options.js",
      "require": "./dist/map-options.cjs"
    },
    "./map-path": {
      "types": "./dist/map-path.d.ts",
      "import": "./dist/map-path.js",
      "require": "./dist/map-path.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
