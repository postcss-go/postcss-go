{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "types": ["node"],
    "paths": {
      "@postcss-go/shared/map-options": ["../shared/dist/map-options.d.ts"],
      "@postcss-go/shared/map-path": ["../shared/dist/map-path.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
