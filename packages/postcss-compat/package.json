{
  "name": "@postcss-go/compat",
  "version": "0.0.0",
  "private": true,
  "description": "PostCSS upstream test harness and Go-backed compat overrides.",
  "type": "module",
  "scripts": {
    "prepare:upstream": "POSTCSS_COMPAT_MODE=upstream node ../../scripts/prepare-upstream-compat.mjs",
    "prepare:go": "POSTCSS_COMPAT_MODE=go node ../../scripts/prepare-upstream-compat.mjs",
    "test:upstream": "POSTCSS_COMPAT_MODE=upstream node ../../scripts/run-upstream-tests.mjs",
    "test:upstream:go": "POSTCSS_COMPAT_MODE=go UPSTREAM_TEST_PATTERN='tokenize\\.test\\.js$' node ../../scripts/run-upstream-tests.mjs",
    "test:upstream:go:parse": "POSTCSS_COMPAT_MODE=go UPSTREAM_TEST_PATTERN='parse\\.test\\.ts$' node ../../scripts/run-upstream-tests.mjs",
    "test:upstream:go:stringify": "POSTCSS_COMPAT_MODE=go UPSTREAM_TEST_PATTERN='stringify\\.test\\.ts$' node ../../scripts/run-upstream-tests.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@postcss-go/core": "workspace:*",
    "nanoid": "^3.3.12",
    "picocolors": "^1.1.1",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "concat-with-sourcemaps": "^1.1.0",
    "nanodelay": "^1.0.8",
    "nanospy": "^1.0.0",
    "postcss-parser-tests": "^8.9.0",
    "strip-ansi": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6",
    "vitest": "^3.2.4"
  }
}
