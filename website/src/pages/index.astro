---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A Go implementation of the PostCSS core architecture, built for speed and compatibility."
    />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>postcss-go — CSS, compiled at the speed of Go</title>
    <script is:inline>
      (() => {
        const system = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem('postcss-go-theme') || system;
        } catch {
          document.documentElement.dataset.theme = system;
        }
      })();
    </script>
  </head>
  <body>
    <main class="overflow-hidden">
      <div class="fixed inset-0 -z-10 grid-bg"></div>
      <div class="fixed inset-0 -z-10 noise"></div>

      <SiteNav />
      <section
        id="top"
        class="relative mx-auto max-w-7xl px-6 pb-24 pt-20 lg:px-10 lg:pb-32 lg:pt-28"
      >
        <div class="max-w-4xl">
          <p class="mb-7 font-mono text-xs uppercase tracking-[.28em] text-acid">
            A faster core for the CSS toolchain
          </p>
          <h1
            class="max-w-4xl text-[clamp(3.5rem,9vw,8.5rem)] font-bold leading-[.88] tracking-[-.075em]"
          >
            PostCSS,<br /><span class="text-acid">rebuilt.</span>
          </h1>
          <p class="mt-9 max-w-2xl text-lg leading-8 text-white/60 lg:text-xl">
            🚀 High-performance PostCSS-compatible CSS processor in Go.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              class="rounded-full bg-acid px-6 py-3 text-sm font-bold text-ink! transition hover:bg-white"
              href={`${import.meta.env.BASE_URL}progress/`}>See the progress</a
            >
            <button
              id="copy-command"
              class="group flex items-center gap-3 rounded-full border border-white/15 bg-white/[.04] px-5 py-3 font-mono text-xs text-white/75 transition hover:border-acid/60"
              ><span class="text-acid">$</span> pnpm add @postcss-go/core <span
                id="copy-state"
                class="text-white/30 transition group-hover:text-white/70">⧉</span
              ></button
            >
          </div>
        </div>
        <div
          class="pointer-events-none absolute -right-20 top-20 hidden select-none font-mono text-[14rem] font-bold leading-none text-white/[.025] lg:block"
        >
          {`{ }`}
        </div>
      </section>

      <section id="progress" class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
        <div class="mb-12 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
          <div>
            <p class="mb-4 font-mono text-xs uppercase tracking-[.25em] text-violet">
              Compatibility progress
            </p>
            <h2 class="text-4xl font-bold tracking-tighter md:text-6xl">64% to parity.</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-white/45">
            The overall engineering estimate for a complete PostCSS JavaScript-compatible runtime.
            See Progress for the module breakdown and remaining work.
          </p>
        </div>
        <div class="home-progress-card">
          <div class="home-progress-card__top">
            <span>FULL POSTCSS JS PARITY</span><strong>64<span>%</span></strong>
          </div>
          <div class="home-progress-card__track"><div style="width: 64%"></div></div>
          <div class="home-progress-card__bottom">
            <span>Go CSS data path / complete</span><a href={`${import.meta.env.BASE_URL}progress/`}
              >View module breakdown ↗</a
            >
          </div>
        </div>
      </section>

      <footer class="border-t border-white/10">
        <div
          class="mx-auto flex max-w-7xl flex-col justify-between gap-6 px-6 py-10 text-xs text-white/35 md:flex-row md:items-center lg:px-10"
        >
          <div class="flex gap-6">
            <a class="hover:text-acid" href="https://github.com/eryue0220/postcss-go">GitHub ↗</a><a
              class="hover:text-acid"
              href={`${import.meta.env.BASE_URL}progress/`}>Compatibility progress ↗</a
            ><span>MIT licensed</span>
          </div>
        </div>
      </footer>
    </main>
    <script>
      const copyButton = document.querySelector('#copy-command');
      const copyState = document.querySelector('#copy-state');
      copyButton?.addEventListener('click', async () => {
        await navigator.clipboard?.writeText('pnpm add @postcss-go/core postcss');
        if (copyState) copyState.textContent = 'copied';
        setTimeout(() => {
          if (copyState) copyState.textContent = '⧉';
        }, 1600);
      });
    </script>
  </body>
</html>
