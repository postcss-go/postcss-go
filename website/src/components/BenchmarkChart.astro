---
import {
  axisMaxMs,
  bootstrapScenarios,
  formatMs,
  relativeToFastest,
  type BenchScenario,
} from '../lib/benchmarks';

function chartModel(scenario: BenchScenario) {
  const measured = scenario.engines.flatMap((engine) => (engine.ns === null ? [] : [engine.ns]));
  const fastest = Math.min(...measured);
  const axisMax = axisMaxMs(measured);
  const ticks = [0, axisMax / 4, axisMax / 2, (axisMax * 3) / 4, axisMax];
  return {
    ...scenario,
    fastest,
    axisMax,
    ticks,
    rows: scenario.engines.map((engine) => {
      if (engine.ns === null) {
        return { ...engine, width: 0, time: '—', relative: '', applicable: false };
      }
      return {
        ...engine,
        width: Math.max(2, (engine.ns / 1e6 / axisMax) * 100),
        time: formatMs(engine.ns),
        relative: relativeToFastest(engine.ns, fastest),
        applicable: true,
      };
    }),
  };
}

const charts = bootstrapScenarios.map(chartModel);
const docsHref = 'https://github.com/eryue0220/postcss-go/blob/main/docs/benchmark.md';
---

<section
  id="benchmarks"
  class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32"
  aria-labelledby="bench-title"
>
  <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
    <div>
      <p class="mb-4 font-mono text-xs uppercase tracking-[.25em] text-violet">Engine comparison</p>
      <h2 id="bench-title" class="text-4xl font-bold tracking-tighter md:text-6xl">
        Other CSS engines,<br />same stylesheet.
      </h2>
    </div>
    <p class="max-w-md text-sm leading-6 text-white/45">
      Bootstrap 5 CSS, 281 KB, no minification. postcss-go is the Go core; PostCSS and CSSTree build
      the same PostCSS-shaped parse / walk / stringify workloads.
    </p>
  </div>

  <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/[.035]" data-bench-tabs>
    <div
      class="flex gap-1 overflow-x-auto border-b border-white/[.08] p-2"
      role="tablist"
      aria-label="Benchmark scenario"
    >
      {
        charts.map((chart, index) => (
          <button
            class="shrink-0 cursor-pointer rounded-lg border-0 bg-transparent px-[.85rem] py-[.65rem] font-mono text-xs text-white/50 transition-colors duration-150 hover:bg-acid/10 hover:text-acid aria-selected:bg-acid/10 aria-selected:text-acid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-acid"
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`bench-panel-${chart.id}`}
            id={`bench-tab-${chart.id}`}
            data-bench-tab={chart.id}
          >
            {chart.label}
          </button>
        ))
      }
    </div>

    {
      charts.map((chart, index) => (
        <div
          class="p-[clamp(1.25rem,4vw,2rem)]"
          id={`bench-panel-${chart.id}`}
          role="tabpanel"
          aria-labelledby={`bench-tab-${chart.id}`}
          data-bench-panel={chart.id}
          hidden={index !== 0}
        >
          <div class="bench-chart" style={`--bench-max: ${chart.axisMax};`}>
            <div class="mb-5 grid gap-3">
              {chart.rows.map((row) => (
                <div class="grid grid-cols-[minmax(7.5rem,9.5rem)_minmax(0,1fr)] items-center gap-4">
                  <a
                    class="truncate font-mono text-xs text-white/60 transition hover:text-acid"
                    href={row.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {row.label}
                    {row.id === 'postcss-go' ? <span class="sr-only"> (this project)</span> : null}
                  </a>
                  {row.applicable ? (
                    <div class="bench-track relative h-10 overflow-hidden rounded-md bg-black/25">
                      <div
                        class:list={[
                          'bench-bar absolute inset-y-0 left-0 rounded-md',
                          row.id === 'postcss-go' ? 'bench-bar--self' : 'bench-bar--other',
                        ]}
                        style={`width: ${row.width}%`}
                      />
                      <div class="relative z-10 flex h-full items-center justify-between gap-3 px-3 font-mono text-xs tabular-nums">
                        <span class:list={[row.id === 'postcss-go' ? 'text-ink' : 'bench-time']}>
                          {row.time}
                        </span>
                        <span
                          class:list={[row.id === 'postcss-go' ? 'text-ink/70' : 'bench-relative']}
                        >
                          {row.relative}
                        </span>
                      </div>
                    </div>
                  ) : (
                    <div class="flex h-10 items-center rounded-md border border-dashed border-white/10 px-3 font-mono text-xs text-white/30">
                      no equivalent API
                    </div>
                  )}
                </div>
              ))}
            </div>
            <div class="relative ml-[calc(9.5rem+1rem)] h-6 max-[640px]:ml-[calc(7.5rem+1rem)]">
              <div class="absolute inset-x-0 top-0 border-t border-white/10" />
              <div class="flex justify-between font-mono text-[.65rem] text-white/30">
                {chart.ticks.map((tick) => (
                  <span>
                    {tick === 0 ? '0' : `${Number.isInteger(tick) ? tick : tick.toFixed(1)} ms`}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <p class="mt-6 max-w-3xl text-sm leading-6 text-white/45">{chart.caption}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-5 flex justify-end">
    <a
      class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-transparent px-[.85rem] py-[.35rem] font-mono text-[.68rem] text-white/50 transition-colors duration-150 hover:border-acid/40 hover:bg-acid/10 hover:text-acid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acid"
      href={docsHref}
      target="_blank"
      rel="noreferrer"
    >
      Methodology <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .bench-bar {
    min-width: 0.4rem;
  }

  .bench-bar--self {
    background: var(--accent);
  }

  .bench-bar--other {
    background: rgba(255, 255, 255, 0.16);
  }

  .bench-time {
    color: rgba(255, 255, 255, 0.82);
  }

  .bench-relative {
    color: rgba(255, 255, 255, 0.35);
  }

  :global(:root[data-theme='light']) .bench-bar--other {
    background: rgba(10, 11, 13, 0.14);
  }

  :global(:root[data-theme='light']) .bench-track {
    background: rgba(10, 11, 13, 0.06);
  }

  :global(:root[data-theme='light']) .bench-time {
    color: rgba(10, 11, 13, 0.82);
  }

  :global(:root[data-theme='light']) .bench-relative {
    color: rgba(10, 11, 13, 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bench-bar {
      transform-origin: left center;
      animation: bench-grow 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }

  @keyframes bench-grow {
    from {
      transform: scaleX(0.08);
      opacity: 0.4;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-bench-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-bench-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-bench-panel]')];

    const activate = (id: string) => {
      for (const tab of tabs) {
        tab.setAttribute('aria-selected', tab.dataset.benchTab === id ? 'true' : 'false');
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.benchPanel !== id;
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => activate(tab.dataset.benchTab ?? ''));
    }
  }
</script>
