---
import '../styles/global.css';
import PageHead from '../components/PageHead.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
  variant?: 'default' | 'api';
  frontmatter?: {
    title?: string;
    variant?: 'default' | 'api';
  };
}

const { frontmatter, title: propTitle, variant: propVariant } = Astro.props;
const title = frontmatter?.title ?? propTitle ?? '';
const variant = frontmatter?.variant ?? propVariant ?? 'default';
---

<html lang="en">
  <head>
    <PageHead title={`${title} · postcss-go`} description={title} />
  </head>
  <body>
    <div class="fixed inset-0 -z-10 grid-bg"></div>
    <div class="fixed inset-0 -z-10 noise"></div>
    <SiteNav />
    <main
      class:list={[
        'progress-content mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-20',
        variant === 'api' && 'api-content',
      ]}
    >
      <slot />
    </main>
  </body>
</html>
