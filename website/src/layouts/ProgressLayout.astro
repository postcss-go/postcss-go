---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const tabClass =
  'shrink-0 cursor-pointer rounded-lg border-0 bg-transparent px-[.85rem] py-[.65rem] font-mono text-[.72rem] text-white/50 transition-colors duration-150 hover:bg-acid/10 hover:text-acid aria-selected:bg-acid/10 aria-selected:text-acid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-acid';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={title} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} · postcss-go</title>
    <script is:inline>
      (() => {
        const system = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem('postcss-go-theme') || system;
        } catch {
          document.documentElement.dataset.theme = system;
        }
      })();
    </script>
  </head>
  <body>
    <div class="fixed inset-0 -z-10 grid-bg"></div>
    <div class="fixed inset-0 -z-10 noise"></div>
    <SiteNav />
    <main class="progress-content mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-20">
      <section class="mb-8 border-t border-white/10 pt-8" aria-labelledby="breakdown-title">
        <div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="mt-0 font-mono text-[.68rem] tracking-[.14em]">MODULE BREAKDOWN</p>
            <h1 id="breakdown-title" class="m-0 text-[clamp(1.8rem,4vw,2.8rem)] leading-none tracking-[-.06em]">Where the work lives.</h1>
          </div>
          <div
            class="flex items-center justify-between gap-2 font-mono text-[.68rem] text-white/40"
          >
            <p>4 surfaces / 1 engine</p>
            <p aria-hidden="true">·</p>
            <p>BASELINE / POSTCSS 8.5.15</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-[.65rem] sm:grid-cols-2">
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 rounded-[.65rem] border border-white/[.08] bg-white/[.025] p-[.9rem]">
            <div>
              <span class="block font-mono text-[.62rem] text-white/40">01</span>
              <strong class="mb-[.2rem] mt-[.35rem] block font-mono text-[.78rem]">Syntax</strong>
              <small class="block font-mono text-[.62rem] text-white/40">Tokenizer · parser · AST · errors</small>
            </div>
            <b class="font-mono text-[1.3rem] text-acid">100%</b>
            <i class="col-span-full h-[.3rem] overflow-hidden rounded-full bg-white/[.08]"><em class="block h-full rounded-[inherit] bg-acid" style="width: 100%"></em></i>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 rounded-[.65rem] border border-white/[.08] bg-white/[.025] p-[.9rem]">
            <div>
              <span class="block font-mono text-[.62rem] text-white/40">02</span>
              <strong class="mb-[.2rem] mt-[.35rem] block font-mono text-[.78rem]">Output</strong>
              <small class="block font-mono text-[.62rem] text-white/40">Stringifier · raws · source maps</small>
            </div>
            <b class="font-mono text-[1.3rem] text-acid">100%</b>
            <i class="col-span-full h-[.3rem] overflow-hidden rounded-full bg-white/[.08]"><em class="block h-full rounded-[inherit] bg-acid" style="width: 100%"></em></i>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 rounded-[.65rem] border border-white/[.08] bg-white/[.025] p-[.9rem]">
            <div>
              <span class="block font-mono text-[.62rem] text-white/40">03</span>
              <strong class="mb-[.2rem] mt-[.35rem] block font-mono text-[.78rem]">Node API</strong>
              <small class="block font-mono text-[.62rem] text-white/40">Mutation · traversal · cloning</small>
            </div>
            <b class="font-mono text-[1.3rem] text-violet">88%</b>
            <i class="col-span-full h-[.3rem] overflow-hidden rounded-full bg-white/[.08]"><em class="block h-full rounded-[inherit] bg-violet" style="width: 88%"></em></i>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 rounded-[.65rem] border border-white/[.08] bg-white/[.025] p-[.9rem]">
            <div>
              <span class="block font-mono text-[.62rem] text-white/40">04</span>
              <strong class="mb-[.2rem] mt-[.35rem] block font-mono text-[.78rem]">JS runtime</strong>
              <small class="block font-mono text-[.62rem] text-white/40">Plugins · lazy result · callbacks</small>
            </div>
            <b class="font-mono text-[1.3rem] text-orange-300">42%</b>
            <i class="col-span-full h-[.3rem] overflow-hidden rounded-full bg-white/[.08]"><em class="block h-full rounded-[inherit] bg-orange-300" style="width: 42%"></em></i>
          </div>
        </div>
      </section>

      <div class="mb-4 flex gap-[.3rem] overflow-x-auto border-b border-white/10 pb-[.45rem]" role="tablist" aria-label="Progress sections">
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="true"
          data-progress-tab="current">Current status</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="compatibility">PostCSS parity work</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="completion">Completion criteria</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="plan">Implementation plan</button
        >
      </div>
      <slot />
    </main>
    <script>
      const progressContent = document.querySelector<HTMLElement>('.progress-content');
      const progressHeadings = progressContent
        ? Array.from(progressContent.children).filter((element) => element.tagName === 'H2')
        : [];

      if (progressContent && progressHeadings.length) {
        const groupFor = (id: string) => {
          if (id === 'current-status') return 'current';
          if (id === 'postcss-parity-work') return 'compatibility';
          if (id === 'scope-and-completion-criteria') return 'completion';
          return 'plan';
        };
        let activeGroup: string | undefined;

        Array.from(progressContent.children).forEach((element) => {
          if (element.tagName === 'H2') activeGroup = groupFor(element.id);
          if (activeGroup) element.dataset.progressGroup = activeGroup;
        });

        progressContent
          .querySelectorAll<HTMLButtonElement>('[data-progress-tab]')
          .forEach((button) => {
            const key = button.dataset.progressTab;
            if (!key) return;
            button.addEventListener('click', () => {
              document
                .querySelectorAll<HTMLButtonElement>('[data-progress-tab]')
                .forEach((tab) => {
                  tab.setAttribute('aria-selected', String(tab === button));
                });
              progressContent
                .querySelectorAll<HTMLElement>('[data-progress-group]')
                .forEach((item) => {
                  item.hidden = item.dataset.progressGroup !== key;
                });
            });
          });
        progressContent.querySelectorAll<HTMLElement>('[data-progress-group]').forEach((item) => {
          item.hidden = item.dataset.progressGroup !== 'current';
        });
      }
    </script>
  </body>
</html>
