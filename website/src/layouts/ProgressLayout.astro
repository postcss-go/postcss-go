---
import '../styles/global.css';
import PageHead from '../components/PageHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { parseRequiredProgress } from '../lib/progress';
import progressSource from '../pages/progress.md?raw';

interface Props {
  title?: string;
  frontmatter?: {
    title?: string;
  };
}

const { frontmatter, title: propTitle } = Astro.props;
const title = frontmatter?.title ?? propTitle ?? '';
const progress = parseRequiredProgress(progressSource);
const progressColors = [
  'text-acid',
  'text-violet',
  'text-orange-300',
  'text-cyan-300',
  'text-acid',
  'text-violet',
  'text-sky-300',
];
const progressBars = [
  'bg-acid',
  'bg-violet',
  'bg-orange-300',
  'bg-cyan-300',
  'bg-acid',
  'bg-violet',
  'bg-sky-300',
];
const progressGroups = progress.groups.map((group, index) => ({
  ...group,
  colorClass: progressColors[index % progressColors.length],
  barClass: progressBars[index % progressBars.length],
}));

const tabClass =
  'shrink-0 cursor-pointer rounded-lg border-0 bg-transparent px-[.85rem] py-[.65rem] font-mono text-[.72rem] text-white/50 transition-colors duration-150 hover:bg-acid/10 hover:text-acid aria-selected:bg-acid/10 aria-selected:text-acid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-acid';
---

<html lang="en">
  <head>
    <PageHead title={`${title} · postcss-go`} description={title} />
  </head>
  <body>
    <div class="fixed inset-0 -z-10 grid-bg"></div>
    <div class="fixed inset-0 -z-10 noise"></div>
    <SiteNav />
    <main class="progress-content mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-20">
      <section class="mb-8 border-t border-white/10 pt-8" aria-labelledby="breakdown-title">
        <div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="mt-0 font-mono text-[.68rem] tracking-[.14em]">REQUIRED WORK</p>
            <h1
              id="breakdown-title"
              class="m-0 text-[clamp(1.8rem,4vw,2.8rem)] leading-none tracking-[-.06em]"
            >
              {progress.percent}% complete.
            </h1>
          </div>
          <div
            class="flex items-center justify-between gap-2 font-mono text-[.68rem] text-white/40"
          >
            <p>{progress.completed} / {progress.total} required criteria</p>
            <p aria-hidden="true">·</p>
            <p>7 workstreams / 1 release target</p>
          </div>
        </div>
        <div
          class="mb-[.65rem] h-[.65rem] overflow-hidden rounded-full border border-white/10 bg-black/25"
          role="progressbar"
          aria-label="Required completion criteria"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={progress.percent}
        >
          <div
            class="h-full rounded-[inherit] bg-gradient-to-r from-acid to-[#e5ff9a]"
            style={`width: ${progress.percent}%`}
          >
          </div>
        </div>
        <div class="grid grid-cols-1 gap-[.65rem] sm:grid-cols-2 lg:grid-cols-3">
          {
            progressGroups.map((group, index) => (
              <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 rounded-[.65rem] border border-white/[.08] bg-white/[.025] p-[.9rem]">
                <div>
                  <span class="block font-mono text-[.62rem] text-white/40">
                    {String(index + 1).padStart(2, '0')} · {group.completed}/{group.total}
                  </span>
                  <strong class="mb-[.2rem] mt-[.35rem] block font-mono text-[.78rem]">
                    {group.shortName}
                  </strong>
                  <small class="block font-mono text-[.62rem] text-white/40">
                    {group.description}
                  </small>
                </div>
                <b class:list={['font-mono text-[1.3rem]', group.colorClass]}>{group.percent}%</b>
                <i
                  class="col-span-full h-[.3rem] overflow-hidden rounded-full bg-white/[.08]"
                  role="progressbar"
                  aria-label={group.name}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={group.percent}
                >
                  <em
                    class:list={['block h-full rounded-[inherit]', group.barClass]}
                    style={`width: ${group.percent}%`}
                  />
                </i>
              </div>
            ))
          }
        </div>
      </section>

      <div
        class="mb-4 flex gap-[.3rem] overflow-x-auto border-b border-white/10 pb-[.45rem]"
        role="tablist"
        aria-label="Progress sections"
      >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="true"
          data-progress-tab="current">Current status</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="required">Required work</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="validation">Optional & gates</button
        >
        <button
          class={tabClass}
          type="button"
          role="tab"
          aria-selected="false"
          data-progress-tab="plan">Implementation plan</button
        >
      </div>
      <slot />
    </main>
    <script>
      const progressContent = document.querySelector<HTMLElement>('.progress-content');
      const progressHeadings = progressContent
        ? Array.from(progressContent.children).filter((element) => element.tagName === 'H2')
        : [];

      if (progressContent && progressHeadings.length) {
        const groupFor = (id: string) => {
          if (id === 'product-target' || id === 'current-status') return 'current';
          if (id === 'required-completion-criteria') return 'required';
          if (id === 'optional-performance-work' || id === 'validation-and-release-gates') {
            return 'validation';
          }
          return 'plan';
        };
        let activeGroup: string | undefined;

        Array.from(progressContent.children).forEach((element) => {
          if (element.tagName === 'H2') activeGroup = groupFor(element.id);
          if (activeGroup) element.dataset.progressGroup = activeGroup;
        });

        progressContent
          .querySelectorAll<HTMLButtonElement>('[data-progress-tab]')
          .forEach((button) => {
            const key = button.dataset.progressTab;
            if (!key) return;
            button.addEventListener('click', () => {
              document.querySelectorAll<HTMLButtonElement>('[data-progress-tab]').forEach((tab) => {
                tab.setAttribute('aria-selected', String(tab === button));
              });
              progressContent
                .querySelectorAll<HTMLElement>('[data-progress-group]')
                .forEach((item) => {
                  item.hidden = item.dataset.progressGroup !== key;
                });
            });
          });
        progressContent.querySelectorAll<HTMLElement>('[data-progress-group]').forEach((item) => {
          item.hidden = item.dataset.progressGroup !== 'current';
        });
      }
    </script>
  </body>
</html>
