{
  "name": "postcss-go-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:go": "gofmt -w .",
    "format:go:check": "test -z \"$(gofmt -l .)\"",
    "format:all": "pnpm format && pnpm format:go",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:go": "go vet -mod=mod ./...",
    "test": "pnpm -r test",
    "test:go": "go test -mod=mod ./...",
    "sync:upstream": "./scripts/sync-upstream-postcss-tests.sh",
    "sync:benchmark-fixtures": "./scripts/sync-benchmark-fixtures.sh",
    "check:upstream": "./scripts/check-upstream-postcss-sync.sh",
    "prepare:upstream-compat": "./scripts/prepare-upstream-compat.sh",
    "test:upstream": "POSTCSS_COMPAT_MODE=upstream ./scripts/run-upstream-tests.sh",
    "test:upstream:go": "pnpm --filter @postcss-go/compat test:upstream:go",
    "check:all": "pnpm format:check && pnpm format:go:check && pnpm lint && pnpm lint:go && pnpm check:upstream && pnpm test && pnpm test:go && pnpm test:upstream && pnpm build",
    "bench": "node scripts/compare-benchmarks.mjs",
    "bench:go": "go test -mod=mod ./benchmark/ -bench=. -benchmem -count=5",
    "bench:postcss": "node benchmark/postcss.bench.mjs",
    "bench:compare": "node scripts/compare-benchmarks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0"
  }
}
