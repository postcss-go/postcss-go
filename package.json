{
  "name": "postcss-go-monorepo",
  "private": true,
  "description": "PostCSSGo Monorepo",
  "homepage": "https://github.com/eryue0220/postcss-go#readme",
  "bugs": {
    "url": "https://github.com/eryue0220/postcss-go/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eryue0220/postcss-go.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "pnpm": ">=9.12.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "changeset": "changeset",
    "changeset:check": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:go": "gofmt -w .",
    "format:go:check": "test -z \"$(gofmt -l .)\"",
    "format:all": "pnpm format && pnpm format:go",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:go": "go vet -mod=mod ./...",
    "test": "pnpm -r test",
    "test:coverage": "pnpm test:coverage:js && pnpm test:coverage:go:check",
    "test:coverage:js": "pnpm -r test:coverage",
    "test:coverage:go": "mkdir -p coverage && GOFLAGS=-mod=mod go test -coverprofile=coverage/go.out ./... && GOFLAGS=-mod=mod go tool cover -func=coverage/go.out | tee coverage/go.txt",
    "test:coverage:go:check": "mkdir -p coverage && GOFLAGS=-mod=mod go test -coverprofile=coverage/go.out ./... && GOFLAGS=-mod=mod go tool cover -func=coverage/go.out | tee coverage/go.txt && awk '/^total:/ { gsub(/%/, \"\", $3); if (($3 + 0) < 65) exit 1 }' coverage/go.txt",
    "test:go": "go test -mod=mod ./...",
    "coverage": "pnpm coverage:go && pnpm coverage:js",
    "coverage:go": "mkdir -p coverage && go test -mod=mod -covermode=atomic -coverprofile=coverage/go.out ./... && go tool cover -func=coverage/go.out | tee coverage/go.txt",
    "coverage:js": "pnpm --filter @postcss-go/core test:coverage",
    "sync:upstream": "node ./scripts/sync-upstream-postcss-tests.mjs",
    "sync:benchmark-fixtures": "node ./scripts/sync-benchmark-fixtures.mjs",
    "check:upstream": "node ./scripts/check-upstream-postcss-sync.mjs",
    "prepare:upstream-compat": "node ./scripts/prepare-upstream-compat.mjs",
    "test:upstream": "POSTCSS_COMPAT_MODE=upstream node ./scripts/run-upstream-tests.mjs",
    "test:upstream:go": "pnpm --filter @postcss-go/compat test:upstream:go",
    "test:upstream:go:parse": "pnpm --filter @postcss-go/compat test:upstream:go:parse",
    "test:upstream:go:stringify": "pnpm --filter @postcss-go/compat test:upstream:go:stringify",
    "check:all": "pnpm format:check && pnpm format:go:check && pnpm lint && pnpm lint:go && pnpm check:upstream && pnpm test && pnpm test:go && pnpm test:upstream && pnpm build",
    "bench": "node scripts/compare-benchmarks.mjs",
    "bench:go": "go test -mod=mod ./benchmark/ -bench=. -benchmem -count=5",
    "bench:postcss": "node benchmark/postcss.bench.mjs",
    "bench:compare": "node scripts/compare-benchmarks.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
