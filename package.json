{
  "name": "@postcss-go/monorepo",
  "private": true,
  "description": "PostCSSGo Monorepo",
  "homepage": "https://github.com/postcss-go/postcss-go#readme",
  "bugs": {
    "url": "https://github.com/postcss-go/postcss-go/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postcss-go/postcss-go.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "pnpm": ">=9.12.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "tree-sitter": "*"
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:release": "pnpm --filter @postcss-go/core build:js && pnpm --filter @postcss-go/core build:wasm && pnpm --filter @postcss-go/vite-loader --filter @postcss-go/webpack-loader --filter @postcss-go/rspack-loader build",
    "check": "turbo run check",
    "check:all": "pnpm format:check && pnpm lint && pnpm check && pnpm check:upstream && pnpm test && pnpm test:upstream && pnpm test:upstream:go && pnpm build",
    "check:upstream": "node ./scripts/check-upstream-postcss-sync.mjs",
    "changeset": "changeset",
    "changeset:check": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "node ./scripts/release.mjs",
    "format:check": "prettier . --check && test -z \"$(find . -name '*.go' -not -path './vendor/*' -not -path '*/node_modules/*' -exec gofmt -l {} +)\"",
    "format": "prettier . --write && find . -name '*.go' -not -path './vendor/*' -not -path '*/node_modules/*' -exec gofmt -w {} +",
    "lint": "pnpm lint:js && pnpm lint:go",
    "lint:js": "eslint .",
    "lint:go": "go vet -mod=mod ./... && node ./scripts/check-go-module-path.mjs",
    "prepare": "husky",
    "prepare:upstream-compat": "node ./scripts/prepare-upstream-compat.mjs",
    "sync:upstream": "node ./scripts/sync-upstream-postcss-tests.mjs",
    "sync:benchmark-fixtures": "node ./benchmark/sync-fixtures.mjs",
    "test": "pnpm test:js && pnpm test:go",
    "test:core-css-contract": "go test -mod=mod ./pkg/api -run CoreCSS && pnpm --filter @postcss-go/core test:core-css-contract",
    "test:js": "turbo run test",
    "test:go": "go test -mod=mod ./...",
    "test:coverage": "pnpm test:coverage:js && pnpm test:coverage:go",
    "test:coverage:js": "turbo run test:coverage",
    "test:coverage:go": "mkdir -p coverage && go test -mod=mod -covermode=atomic -coverprofile=coverage/go.out ./... && go tool cover -func=coverage/go.out | tee coverage/go.txt && node ./scripts/check-go-coverage.mjs",
    "test:upstream": "POSTCSS_COMPAT_MODE=upstream node ./scripts/run-upstream-tests.mjs",
    "test:upstream:go": "pnpm --filter @postcss-go/compat test:upstream:go",
    "bench": "node benchmark/run.mjs",
    "bench:boundary": "node benchmark/run-boundary.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@lezer/css": "^1.3.4",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.2.6",
    "css-tree": "^3.2.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tree-sitter": "npm:web-tree-sitter@^0.26.9",
    "tree-sitter-css": "^0.25.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "web-tree-sitter": "^0.26.9"
  }
}
